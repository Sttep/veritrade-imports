%% Flujo del pipeline Veritrade — arquitectura medallion (bronze -> silver -> gold)
%% Render: https://mermaid.live  o  mmdc -i docs/flujo.mmd -o docs/flujo.svg
flowchart TD
    RAW[("data/bronze/*.xlsx<br/>exports Veritrade crudos (privado)")]:::input
    REFS[("refs/*.xlsx<br/>reportes mensuales AAP")]:::input

    %% ---------- Silver: parser determinístico ----------
    subgraph SV["pipeline/silver.py — Bronze -> Silver (gratis, sin red)"]
        EXTRACT["tokeniza CÓDIGO:valor<br/>~28 columnas tipadas"]:::script
        SILVER[("data/silver/&lt;stem&gt;_fase1.xlsx")]:::output
        EXTRACT --> SILVER
    end
    RAW --> EXTRACT

    %% ---------- Vocabulario ----------
    VX[("data/vocab_extra.json<br/>marcas nuevas / alias /<br/>alias de modelo")]:::input
    VOCAB["pipeline/llm/vocab.py<br/>fusiona semilla + extra"]:::script
    VX --> VOCAB

    %% ---------- Gold: normalización LLM ----------
    subgraph GD["pipeline/gold.py — Silver -> Gold (normalización LLM)"]
        SAMP["llm/sampler.py<br/>muestreo por confianza"]:::script
        CACHE[("cache.py<br/>.cache/llm/<br/>dedup + reanudable")]:::cache
        CLIENT["llm/client.py -> api.deepseek.com<br/>batching · retry · prompt-cache"]:::ext
        VAL["llm/validate.py<br/>enums + rapidfuzz + model_aliases<br/>-> flag: ok / alias / low / nomatch"]:::script
        REP["llm/report.py<br/>cobertura · costo"]:::script

        SAMP -->|texto no cacheado| CLIENT --> CACHE -->|raw LLM| VAL --> REP
    end
    SILVER -->|+ texto crudo desc| SAMP
    VOCAB --> SAMP
    VOCAB --> VAL

    GOLD[("data/gold/&lt;stem&gt;_normalizado.xlsx<br/>normalizado_final · _revisar_final<br/>_vocab_nuevo · _reporte")]:::output
    REP --> GOLD

    %% ---------- Consolidación ----------
    BUILD["pipeline/build_parquet.py<br/>une + dedup por DUA+VIN"]:::script
    GOLD --> BUILD
    PARQUET[("data/gold/camiones.parquet<br/>(y maquinaria.parquet)")]:::output
    BUILD --> PARQUET

    %% ---------- Referencia AAP y cobertura ----------
    AAP["pipeline/aap.py"]:::script
    REFS --> AAP
    AAP_OUT[("data/gold/aap_camiones.parquet")]:::output
    AAP --> AAP_OUT

    COBERTURA["scripts/validar_cobertura.py<br/>cobertura Veritrade vs AAP por marca"]:::script
    PARQUET --> COBERTURA
    AAP_OUT --> COBERTURA

    %% ---------- Dashboard ----------
    DASH["app.py + pages/2_Camiones.py<br/>(Streamlit Cloud)"]:::nb
    PARQUET --> DASH

    %% ---------- Loop de curación ----------
    GOLD -.->|"_revisar_final / _vocab_nuevo — validación SME"| CURA{{"¿Ampliar diccionario?"}}:::decision
    CURA -.->|editar| VX
    CURA -.->|re-normalizar GRATIS desde cache| SAMP

    classDef input fill:#FFF3CD,stroke:#B8860B,color:#000
    classDef output fill:#D1E7DD,stroke:#0F5132,color:#000
    classDef script fill:#CFE2FF,stroke:#084298,color:#000
    classDef nb fill:#E2D9F3,stroke:#59359A,color:#000
    classDef cache fill:#E2E3E5,stroke:#41464B,color:#000
    classDef ext fill:#F8D7DA,stroke:#842029,color:#000
    classDef decision fill:#FFE5B4,stroke:#B8860B,color:#000
